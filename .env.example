# ===========================================
# Avito Parser Configuration
# ===========================================

# --- PROXY SETTINGS ---
# Avito uses Cloudflare Bot Management with TLS fingerprinting.
# Free proxies DO NOT WORK for Avito — they are all banned.
# You need PAID mobile or residential proxies.

# Option 1: Server/Residential proxy
# Format: login:password@host:port
# PROXIES=user:pass@proxy.example.com:8080

# Option 2: Mobile proxy with IP rotation API
# Provider: mobileproxy.space (~2500 RUB/month)
# MOBILE_PROXY_URL=login:pass@proxy.mobileproxy.space:8080
# MOBILE_PROXY_CHANGE_URL=https://api.mobileproxy.space/change
# MOBILE_PROXY_TYPE=http

# --- SEARCH SETTINGS ---
DEFAULT_CITY=moskva
DEFAULT_RADIUS=200

# --- RATE LIMITING ---
# Optimal settings for Avito (without proxy):
#   MAX_CONCURRENT_REQUESTS=1
#   MIN_DELAY_SECONDS=5.0
#   MAX_DELAY_SECONDS=10.0
#
# With mobile proxy:
#   MAX_CONCURRENT_REQUESTS=2-3
#   MIN_DELAY_SECONDS=3.0
#   MAX_DELAY_SECONDS=6.0

MAX_CONCURRENT_REQUESTS=1
MIN_DELAY_SECONDS=5.0
MAX_DELAY_SECONDS=10.0

# --- RETRY SETTINGS ---
MAX_RETRIES=3
RETRY_WAIT_MIN=5
RETRY_WAIT_MAX=60

# --- STORAGE ---
DATABASE_PATH=data/avito.db

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FILE=logs/avito.log

# --- API KEY ---
# Ключ API для мобильного API Avito (статический, одинаков для всех пользователей)
AVITO_API_KEY=af0deccbgcgidddjgnvljitntccdduijhdinfgjgfjir

# --- TELEGRAM (опционально) ---
# Токен бота Telegram для отправки уведомлений о находках
# TELEGRAM_BOT_TOKEN=your_bot_token
# ID чата Telegram для отправки уведомлений
# TELEGRAM_CHAT_ID=your_chat_id

# --- FINANCIAL SETTINGS ---
# Маржа прибыли по умолчанию для анализа (30%)
PROFIT_MARGIN=0.30
# Комиссия платформы при перепродаже (10%)
COMMISSION_RATE=0.10
# Коэффициент перепродажи — консервативная оценка цены перепродажи (90% от медианы)
RESALE_FACTOR=0.90
# Маржа для быстрых сделок (20%)
QUICK_FLIP_MARGIN=0.20
# Маржа для глубоких сделок (40%)
DEEP_FLIP_MARGIN=0.40
